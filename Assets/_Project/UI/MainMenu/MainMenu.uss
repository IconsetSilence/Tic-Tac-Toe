.std-button {
    align-self: center;
    width: 25%;
    height: 10%;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    font-size: 60px;
    -unity-font-style: normal;
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
    bottom: auto;
    top: 775px;
}
