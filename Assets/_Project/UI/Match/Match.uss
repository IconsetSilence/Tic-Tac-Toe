.standard-text {
    font-size: 80px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    letter-spacing: 2px;
}

.std-button {
    align-self: flex-start;
    font-size: 80px;
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/ThirdParty/CasualGameButtonsVol02/CGB02-blue_L_btn.png?fileID=-1573344661467012158&guid=b9bb3e95f0ba711418a04c7c0bb8bf33&type=3#CGB02-blue_L_btn_0");
    background-color: rgba(0, 0, 0, 0);
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-align: middle-center;
    -unity-background-scale-mode: scale-to-fit;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    width: 400px;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    position: absolute;
}

.std-button:hover {
    -unity-background-image-tint-color: rgb(200, 200, 200);
    color: rgb(200, 200, 200);
    -unity-text-outline-color: rgb(200, 200, 200);
}

.std-button:active {
    -unity-background-image-tint-color: rgb(100, 100, 100);
    color: rgb(100, 100, 100);
    -unity-text-outline-color: rgb(100, 100, 100);
}

#counter {
    align-self: center;
    flex-direction: row;
}

#player-counter {
    color: rgb(255, 0, 0);
    -unity-text-outline-color: rgb(255, 0, 0);
    margin-right: 40px;
}

#enemy-counter {
    color: rgb(0, 93, 255);
    -unity-text-outline-color: rgb(0, 43, 255);
}

#turn {
    position: absolute;
    right: 100px;
    top: 35px;
}

#turn-text {
    color: rgb(11, 255, 0);
    -unity-text-outline-color: rgb(24, 255, 0);
}

#turn-anyone {
    color: rgb(255, 255, 255);
    -unity-text-outline-color: rgb(255, 255, 255);
}
