#counter {
    align-self: center;
    top: 175px;
    flex-direction: row;
}

.count {
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 5px;
    font-size: 90px;
    -unity-text-align: middle-center;
    margin-left: 30px;
    margin-right: 30px;
    top: -550px;
}

#player-count {
    color: rgb(255, 0, 0);
    -unity-text-outline-color: rgb(255, 0, 0);
}

#enemy-count {
    color: rgb(0, 80, 255);
    -unity-text-outline-color: rgb(0, 90, 255);
}

#field {
    background-image: url("project://database/Assets/ThirdParty/tic-tac-toe/Pillar.png?fileID=2800000&guid=5933edd714163354eb8a1f360915d2d9&type=3#Pillar");
    -unity-background-scale-mode: scale-to-fit;
    background-size: 35% 70%;
    top: 200px;
    position: absolute;
    width: 2000px;
    height: 1000px;
    align-self: center;
    align-items: center;
    align-content: flex-end;
}

.mark {
    background-color: rgba(0, 0, 0, 0);
    width: 160px;
    height: 160px;
    align-self: center;
    align-content: center;
    justify-content: center;
    align-items: center;
    position: absolute;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

#mark-1 {
    top: 175px;
    left: 680px;
}

#mark-2 {
    top: 175px;
    left: 917px;
}

#mark-3 {
    top: 175px;
    left: 1150px;
}

#mark-4 {
    top: 420px;
    left: 680px;
}

#mark-5 {
    top: 420px;
    left: 917px;
}

#mark-6 {
    top: 420px;
    left: 1150px;
}

#mark-7 {
    top: 660px;
    left: 680px;
}

#mark-8 {
    top: 660px;
    left: 917px;
}

#mark-9 {
    top: 660px;
    left: 1150px;
}
