#counter {
    align-self: center;
    font-size: 80px;
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 3px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    letter-spacing: 2px;
    flex-direction: row;
}

#player-counter {
    color: rgb(255, 0, 0);
    -unity-text-outline-color: rgb(255, 0, 0);
    margin-right: 40px;
}

#enemy-counter {
    color: rgb(0, 93, 255);
    -unity-text-outline-color: rgb(0, 43, 255);
}
